{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Especie de pez",
  "description": "Atributos cuantitativos que configuran una especie de pez.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nombre",
    "color",
    "nivelTrofico",
    "espectroTrofico",
    "tamano",
    "radius",
    "radioPercepcion",
    "velocidadBase",
    "velocidadRafaga",
    "energiaMaxima",
    "energiaInicial",
    "umbralHambre",
    "umbralReproduccion",
    "eficienciaAsimilacion",
    "costoMetabolicoBase",
    "costoLocomocion"
  ],
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Nombre de la especie; no puede estar vacio ni contener solo espacios."
    },
    "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "description": "Color RGB de los peces: [rojo, verde, azul]."
    },
    "nivelTrofico": {
      "type": "number",
      "minimum": 0,
      "description": "Nivel trofico de la especie."
    },
    "espectroTrofico": {
      "type": "array",
      "description": "Intervalo de niveles troficos consumidos: [minTL, maxTL].",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "description": "Nivel trofico minimo."
        },
        {
          "type": "number",
          "minimum": 0,
          "description": "Nivel trofico maximo."
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "tamano": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Tamano de los peces de la especie."
    },
    "radius": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Radio de los peces de la especie."
    },
    "radioPercepcion": {
      "type": "number",
      "minimum": 0,
      "description": "Distancia maxima de percepcion del entorno."
    },
    "velocidadBase": {
      "type": "number",
      "minimum": 0,
      "description": "Velocidad habitual; valor inicial de maxSpeed."
    },
    "velocidadRafaga": {
      "type": "number",
      "minimum": 0,
      "description": "Velocidad de desplazamiento en rafaga."
    },
    "energiaMaxima": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Energia maxima que puede almacenar un pez."
    },
    "energiaInicial": {
      "type": "number",
      "minimum": 0,
      "description": "Energia al crear un pez; valor inicial de energia."
    },
    "umbralHambre": {
      "type": "number",
      "minimum": 0,
      "description": "Umbral de energia para activar el comportamiento de hambre."
    },
    "umbralReproduccion": {
      "type": "number",
      "minimum": 0,
      "description": "Umbral de energia necesario para la reproduccion."
    },
    "eficienciaAsimilacion": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Fraccion de la energia ingerida que se asimila, entre 0 y 1."
    },
    "costoMetabolicoBase": {
      "type": "number",
      "minimum": 0,
      "description": "Costo energetico del metabolismo basal."
    },
    "costoLocomocion": {
      "type": "number",
      "minimum": 0,
      "description": "Costo energetico de la locomocion."
    }
  }
}
