{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Example schema, not related to fish species",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "tags"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}